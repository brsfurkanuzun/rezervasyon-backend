# Copy to backend/.env for local development (never commit .env).
# Production values belong in Railway → service → Variables, not in files.

# Cloudinary (server-side only; never put these in a VITE_/NEXT_PUBLIC_ frontend variable)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional upload tuning (defaults shown in application.yml)
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=6MB
IMAGE_STORAGE_ROOT=resplz
